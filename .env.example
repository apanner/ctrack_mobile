# ctrack_mobile environment variables
# Copy to .env and fill in values

# Backend API base URL (ctrack_v0)
# Required for timesheets, leaves, expenses, chat, etc.
# Use https://your-domain.com in production; http://localhost:3000 for local dev
EXPO_PUBLIC_API_URL=

# Supabase project URL
# Required for auth and direct Supabase queries
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key
# Required for auth and RLS
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry DSN for error reporting
# If set, ErrorBoundary will send caught errors to Sentry
# EXPO_PUBLIC_SENTRY_DSN=

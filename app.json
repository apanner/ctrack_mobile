{
  "expo": {
    "name": "CTrack Artist Manager",
    "slug": "cinetrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.cinetrack-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "app.rork.cinetrack_mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "CTrack Artist Manager",
      "shortName": "CTrack",
      "themeColor": "#0A0A0F",
      "backgroundColor": "#0A0A0F",
      "display": "standalone",
      "orientation": "portrait"
    },
    "scheme": "cinetrack",
    "plugins": ["expo-router", "expo-notifications", ["expo-image-picker", {"photosPermission": "Allow CTrack to access your photos to share images in chat."}], ["expo-audio", {"microphonePermission": "Allow CTrack to access your microphone to record voice messages."}],

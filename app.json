{
  "expo": {
    "name": "CTrack Artist Manager",
    "slug": "cinetrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F12"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.cinetrack-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F12"
      },
      "package": "app.rork.cinetrack_mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "CTrack Artist Manager",
      "shortName": "CTrack",
      "themeColor": "#0D0F12",
      "backgroundColor": "#0D0F12",
      "display": "standalone",
      "orientation": "portrait",
      "icons": [
        { "src": "./assets/icon.png", "sizes": "192x192", "type": "image/png" },
        { "src": "./assets/icon.png", "sizes": "512x512", "type": "image/png" }
      ]
    },
    "scheme": "cinetrack",
    "plugins": ["expo-router", "expo-notifications", ["expo-image-picker", {"photosPermission": "Allow CTrack to access your photos to share images in chat."}], ["expo-audio", {"microphonePermission": "Allow CTrack to access your microphone to record voice messages."}],
      ["expo-location", {"locationWhenInUsePermission": "Allow CTrack to use your location for shift GPS tracking. Supervisors can see your position during work hours."}]],
